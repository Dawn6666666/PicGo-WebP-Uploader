# Leave empty to select gallery when R2_GALLERY_URL is set, otherwise picgo.
UPLOAD_BACKEND=

# R2 gallery backend. Set a password or an auth-token cookie value.
R2_GALLERY_URL=
R2_GALLERY_PASSWORD=
R2_GALLERY_TOKEN=

# PicGo backend. Leave empty to use the CLI and its default configuration.
PICGO_PATH=
PICGO_CONFIG=
